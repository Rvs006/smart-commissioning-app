# Copy this file to infra/.env and replace every CHANGE_ME placeholder before
# running `docker compose` — or run scripts/bootstrap-env.ps1 (Windows) /
# scripts/bootstrap-env.sh (Linux/macOS), which does both in one step.
# Compose reads .env from the directory containing
# docker-compose.yml. Never commit the real .env; none of the values below are
# usable secrets — compose refuses to start while placeholders are missing.

# --- Postgres ---------------------------------------------------------------
# Database name and role used by the api and worker. DATABASE_URL is assembled
# inside docker-compose.yml from these three values, so they only live here.
POSTGRES_DB=smart_commissioning
POSTGRES_USER=smart_commissioning
# Database password. Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32

# --- Redis ------------------------------------------------------------------
# Password enforced via `redis-server --requirepass`. REDIS_URL is assembled
# inside docker-compose.yml from this value. Generate with: openssl rand -hex 32
REDIS_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32

# --- API authentication -----------------------------------------------------
# Shared API key required by the backend when AUTH_MODE=api_key (the compose
# default). Clients send it with every /api request; the frontend prompts for
# it and stores it locally. Generate with: openssl rand -hex 32
API_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# Stable, non-secret identifier folded into per-run MQTT client IDs. Keep this
# value unchanged for the lifetime of the deployment; use ASCII letters,
# digits, and hyphens only (for example, commissioning-host-01).
SMART_COMMISSIONING_DEPLOYMENT_ID=commissioning-host-01

# Network discovery previews and live runs must be resolved and executed in
# one OS network namespace. Leave this blank for the stock Compose topology,
# whose api and worker are separate containers; network discovery then fails
# closed before a run is created. Set a stable non-secret ID only in a Compose
# override that co-locates api and worker networking and dedicates the discovery
# queue lane to that namespace.
#SMART_COMMISSIONING_NETWORK_EXECUTOR_ID=commissioning-network-executor-01

# Internal operator-managed Nmap is a Windows portable-inline feature and is
# disabled by default. Do not enable it in the stock two-container topology.
#SMART_COMMISSIONING_NMAP_INTERNAL_PROVIDER_ENABLED=0

# --- Optional overrides (sane defaults in docker-compose.yml) ----------------
# Host port (loopback only) where nginx serves the frontend and /api proxy.
#FRONTEND_PORT=8080
# Host port (loopback only) for direct API access while debugging.
#API_PORT=8000
# Host port (loopback only) for direct Postgres access while debugging.
#POSTGRES_PORT=5432
# Comma-separated browser origins allowed by CORS for direct cross-origin API
# access. Same-origin traffic through the nginx /api proxy never needs CORS.
#CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# --- Image provenance and digest deployment --------------------------------
# Local builds use the defaults below. A published deployment should replace
# all three image values with the immutable name@sha256 references recorded in
# the release's docker-image-evidence.json and start Compose with --no-build.
#APP_VERSION=dev
#SOURCE_COMMIT=unknown
#SOURCE_REPOSITORY=https://github.com/Rvs006/smart-commissioning-app
#API_IMAGE=smart-commissioning-api:local
#WORKER_IMAGE=smart-commissioning-worker:local
#FRONTEND_IMAGE=smart-commissioning-frontend:local
