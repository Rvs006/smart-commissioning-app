            "diagram",
            "annotated-code"
          ],
          "policy": "required-on-pr"
        },
        {
          "id": "core-smart_commissioning_core-records-py",
          "name": "Records.Py",
          "kind": "area",
          "include": [
            "core/smart_commissioning_core/records.py"
          ],
          "blocks": [
            "file-tree",
            "diagram",
            "annotated-code"
          ],
          "policy": "seed"
        },
        {
          "id": "core-smart_commissioning_core-sync-py",
