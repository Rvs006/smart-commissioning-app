{
  "version": 1,
  "apps": {
    "visualize-repo": {
      "mode": "local-files",
      "root": ".agent-native/visual-docs",
      "entry": ".agent-native/visual-docs/repo-overview",
      "targets": [
        {
          "id": "backend-app-main-py",
          "name": "Main.Py",
          "kind": "area",
          "include": [
            "backend/app/main.py"
          ],
          "blocks": [
            "file-tree",
            "diagram",
            "annotated-code"
          ],
          "policy": "seed"
        },
        {
          "id": "backend-app-api-router-py",
          "name": "Router.Py",
          "kind": "area",
          "include": [
            "backend/app/api/router.py"
          ],
          "blocks": [
            "file-tree",
            "diagram",
            "annotated-code"
          ],
          "policy": "seed"
        },
        {
          "id": "backend-app-services-run_service-py",
          "name": "Run Service.Py",
          "kind": "area",
          "include": [
            "backend/app/services/run_service.py"
          ],
          "blocks": [
            "file-tree",
            "diagram",
            "annotated-code"
          ],
          "policy": "seed"
        },
        {
          "id": "backend-app-services-run_dispatch-py",
          "name": "Run Dispatch.Py",
          "kind": "area",
          "include": [
            "backend/app/services/run_dispatch.py"
          ],
          "blocks": [
            "file-tree",
            "diagram",
            "annotated-code"
          ],
          "policy": "seed"
        },
        {
          "id": "backend-app-api-routes-scanner_raw-py",
          "name": "Scanner Raw.Py",
          "kind": "flow",
          "include": [
            "backend/app/api/routes/scanner_raw.py"
          ],
          "blocks": [
            "wireframe",
            "diagram",
            "annotated-code"
          ],
          "policy": "seed"
        },
        {
          "id": "core-smart_commissioning_core-engines-base-py",
          "name": "Base.Py",
          "kind": "area",
          "include": [
            "core/smart_commissioning_core/engines/base.py"
          ],
          "blocks": [
            "file-tree",
            "diagram",
            "annotated-code"
          ],
          "policy": "seed"
        },
        {
          "id": "core-smart_commissioning_core-db-models-py",
